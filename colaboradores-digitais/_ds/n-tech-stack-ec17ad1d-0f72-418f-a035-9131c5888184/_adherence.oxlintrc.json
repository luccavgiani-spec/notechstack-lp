{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "doc-page.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Sora, JetBrains Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--font-core",
      "--font-mono",
      "--health-acc",
      "--health-claro",
      "--health-dark",
      "--no-ambar",
      "--no-ambar-claro",
      "--no-azul",
      "--no-azul-claro",
      "--no-borda",
      "--no-cinza",
      "--no-osso",
      "--no-tinta",
      "--no-verde",
      "--no-verde-claro",
      "--no-vermelho",
      "--no-vermelho-claro",
      "--roteador-acc",
      "--roteador-claro",
      "--roteador-dark",
      "--shadow-card"
    ],
    "tokenKinds": {
      "--no-azul": "color",
      "--no-vermelho": "color",
      "--no-ambar": "color",
      "--no-verde": "color",
      "--no-azul-claro": "color",
      "--no-vermelho-claro": "color",
      "--no-ambar-claro": "color",
      "--no-verde-claro": "color",
      "--no-tinta": "color",
      "--no-osso": "color",
      "--no-cinza": "color",
      "--no-borda": "color",
      "--health-dark": "color",
      "--health-acc": "color",
      "--health-claro": "color",
      "--roteador-dark": "color",
      "--roteador-acc": "color",
      "--roteador-claro": "color",
      "--font-core": "font",
      "--font-mono": "font",
      "--shadow-card": "shadow"
    },
    "fontFamilies": [
      "JetBrains Mono",
      "Sora"
    ]
  }
}